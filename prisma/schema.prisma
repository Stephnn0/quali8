
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}


model ShopifyStore {
  id                   Int                   @id @default(autoincrement())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
  //
  shop                 String                @unique
  shopifyPlan          String? // TODO - Delete after all stores are using the new shopData
  status               AppStatus
  appVersion           String                @default("0.0.0")
  //
  qualifiers           Qualifiers[]
  customers            Customers[]   
  conditions           Conditions[]       
}

enum AppStatus {
  INSTALLED
  SETUP
  UNINSTALLED
}

enum LogicType {
  AND
  OR
}

enum ConditionType {
  customer_tag
  customer_order_count
  customer_email
  customer_country
  customer_amount_spent
}

enum ComparisonType {
  equals
  not_equals

}


model Qualifiers {
  id                   Int                   @id @default(autoincrement())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
  //
  shop                 String
  shopifyStore         ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)
  //
  name               String
  description        String
  conditionLogicType LogicType
  //
  conditions         Conditions[] 
  customers          Customers[]   @relation("CustomerQualifiers")
}

model Conditions {
  id             Int            @id @default(autoincrement())
  type           ConditionType 
  comparisonType ComparisonType
  value          String

  //
  qualifierId    Int
  qualifier      Qualifiers      @relation(fields: [qualifierId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  //
  shop                 String
  shopifyStore         ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)
}

model Customers {
  id                   Int         @id @default(autoincrement())
  email                String      @unique
  firstName            String?
  lastName             String?
  qualifiers           Qualifiers[] @relation("CustomerQualifiers")
  //
  shop                 String
  shopifyStore         ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)

}