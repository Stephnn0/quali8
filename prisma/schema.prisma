generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model ShopifyStore {
  id                   Int                      @id @default(autoincrement())
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @default(now()) @updatedAt
  //
  shop                 String                   @unique
  shopifyPlan          String? // TODO - Delete after all stores are using the new shopData
  status               AppStatus
  appVersion           String                   @default("0.0.0")
  functionId           String?
  /// GID of the shop's single automatic app discount backing all active
  /// bundles (extensions/bundle-discounts). Null until a bundle is activated.
  bundleDiscountId     String?
  /// Storefront zip code delivery checker (Announcements + Delivery Check)
  deliveryCheckEnabled Boolean                  @default(false)
  /// GID of the app's carrier service once registered (Delivery Rates)
  carrierServiceId     String?
  //
  qualifiers           Qualifiers[]
  customers            Customers[]
  conditions           Conditions[]
  shippingDiscounts    ShippingDiscountAction[]
  shopifySubscriptions ShopifySubscription[]
  shopData             ShopifyShopData?

  // NEW
  campaigns Campaign[]
  bundles   Bundle[]
  occasions Occasion[]
  recommendationRules RecommendationRule[]
  deliveryZones       DeliveryZone[]
  carrierRate         CarrierRate?
  deliverySchedule    DeliverySchedule?
  deliveryTimeWindows DeliveryTimeWindow[]
  cartOptions         CartOptionsSettings?

  storeProfile   StoreProfile?
  dashboardBrief DashboardBrief?
  specialDates   SpecialDate[]
  aiUsage        AiUsage[]
  collectionFaqs CollectionFaq[]
}

enum AppStatus {
  INSTALLED
  SETUP
  UNINSTALLED
}

enum LogicType {
  AND
  OR
}

enum ConditionType {
  customer_tag
  customer_order_count
  customer_email
  customer_country
  customer_amount_spent
  updated_at
  tag_not
  order_date
  last_name
  last_abandoned_order_date
  first_name
  customer_date
  accepts_marketing
}

enum ComparisonType {
  equals
  not_equals
  greater_than
  less_than
  greater_than_equals
  less_than_equals
}

// Audience
model Qualifiers {
  id                 Int          @id @default(autoincrement())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt
  //
  shop               String
  shopifyStore       ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)
  //
  name               String
  description        String
  conditionLogicType LogicType
  /// When membership was last synced from Shopify (save or manual refresh).
  /// Null for audiences created before this column existed.
  lastSyncedAt       DateTime?
  //
  conditions         Conditions[]
  customers          Customers[]  @relation("CustomerQualifiers")
  //
  campaigns          Campaign[]
}

model Conditions {
  id             Int            @id @default(autoincrement())
  type           ConditionType
  comparisonType ComparisonType
  value          String

  //
  qualifierId  Int // audience
  qualifier    Qualifiers   @relation(fields: [qualifierId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  //
  shop         String
  shopifyStore ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)
}

model Customers {
  id           Int          @id @default(autoincrement())
  shopifyId    String       @unique
  email        String?
  firstName    String?
  lastName     String?
  //
  country      String?
  amountSpent  String?
  orderCount   Int?
  qualifiers   Qualifiers[] @relation("CustomerQualifiers")
  //
  shop         String
  shopifyStore ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)
  //
}

model ShippingDiscountAction {
  id                           Int                   @id @default(autoincrement())
  shopifyDiscountId            String                @unique
  //
  shippingDiscountState        ShippingDiscountState
  limitUsagePerOneCustomer     Boolean               @default(false)
  combinedWithOrderDiscounts   Boolean               @default(false)
  combinedWithProductDiscounts Boolean               @default(false)
  //
  automaticOrCode              String // 'CODE' or 'AUTOMATIC'
  codeOrName                   String
  type                         DiscountType // percentage or fixed 
  value                        Int
  //            
  shippingRateType             ShippingRateType
  shippingRatesNames           String[] //! fixed this maybe by handle or name
  qualifierIds                 String[]
  //
  appliesToAllCustomers        Boolean               @default(false)
  //
  isMinimumCartValueEnabled    Boolean               @default(false)
  minimumCartValue             Float?                @default(0)
  //
  startDate                    String?
  startTime                    String?
  hasEndDate                   Boolean               @default(false)
  endDate                      String?
  endTime                      String?
  //
  //
  shop                         String
  shopifyStore                 ShopifyStore          @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)
  //
  //
  promotions                   Promotion[]
  //
  //
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @default(now()) @updatedAt
}

enum MarketingActionType {
  SHIPPING_DISCOUNTS
  // Add more like FREE_GIFT, PERCENTAGE_DISCOUNT, etc.
}

enum DiscountType {
  percentage
  fixed
}

enum ShippingRateType {
  ALL_RATES
  SELECTED_RATES
}

enum ShippingDiscountState {
  ENABLED
  DISABLED
}

// https://shopify.dev/docs/api/admin-graphql/latest/objects/AppSubscription
// https://shopify.dev/docs/apps/launch/billing/subscription-billing
// 
// Shopify Subscriptions are different than traditional subscriptions
// The name "Subscription" is used to encapsulate the concept of a billing agreement between the app and the store owner
//
// The agreement (Subscription) may contain a recurring charge, a usage-based charge, or both, but not neither (i.e., it must have at least one of them).
// In Shopify's API these treated as LineItems, which are part of the AppSubscription object
// In our app, we simplify this by just flattening and removing the LineItems property.
//
// Here are some key points about Shopify Subscriptions:
// - A subscription may have a maximum of one recurring charge and one usage charge, and a minimum or one of them.
// - A subscription may have a trial period, which is a fixed number of days a subscription won't be billed for.
// - A subscription is just an agreement, the actual terms are under the Plan (lineItem) object.
// - A subscription can be cancelled manually or automatically (by uninstalling the app).
// - Re-subscribing, or changing subscription agreement (the plan), creates a new subscription (with a new Shopify ID) and ends the previous one.
// - An app may have a maximum of one active subscription per store. This might be confusing as Shopify returns `activeSubscriptions` as an array, but they state that you can only have one. https://shopify.dev/docs/apps/launch/billing/subscription-billing#how-it-works
// TODO - verify how the trialDays work when the subscription includes usage-based charges, what happens to these charges during the trial period?
//

model ShopifySubscription {
  id                             Int                           @id @default(autoincrement())
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @default(now()) @updatedAt
  //
  shopifyId                      String /// GID of the subscription in the form of `"gid://shopify/AppSubscription/1234567890"`
  name                           String /// Subscription name.
  startDate                      DateTime                      @default(now()) /// Subscription start date, map to `createdAt` in Shopify
  currentPeriodEnd               DateTime? /// Subscription end date, if active
  status                         SubscriptionStatus /// Shopify subscription status - https://shopify.dev/docs/api/admin-graphql/latest/objects/appsubscription#field-status
  test                           Boolean                       @default(false) /// Whether the subscription is in test mode (Only for development purposes)
  trialDays                      Int? /// Number of days the subscription is in trial period
  cancelMethod                   CancellationMethod? /// If the subscription was cancelled, it means how it was cancelled.
  //
  // TODO - These two should have a check constraint to ensure atleast one of them is not null
  // TODO - there must be a check where if one is set, the respecive counterpart must be set too, for example, if `shopifyRecurringPricing` is set, then `recurringPlan` must be set too.
  shopifyRecurringPricingId      Int? ///  Use `connectOrCreate`
  shopifyRecurringPricing        ShopifyRecurringPricing?      @relation(fields: [shopifyRecurringPricingId], references: [id], onDelete: Restrict, onUpdate: Cascade) /// Use `connectOrCreate`. These are the pricing details that Shopify will charge the merchant.
  unstable_shopifyUsagePricingId Int? /// Unstable, do not use in production. Use `connectOrCreate`
  unstable_shopifyUsagePricing   Unstable_ShopifyUsagePricing? @relation(fields: [unstable_shopifyUsagePricingId], references: [id], onDelete: Restrict, onUpdate: Cascade) /// Unstable, do not use in production. Use `connectOrCreate`. These are the pricing details that Shopify will charge the merchant. 
  //
  // TODO - These two should have a check constraint to ensure atleast one of them is not null
  // TODO - there must be a check where if one is set, the respecive counterpart must be set too, for example, if `recurringPlan` is set, then `shopifyRecurringPricing` must be set too.
  // These are our own internal pricing details that we use to compare with Shopify's pricing (in case of discount, refund, etc) and associate extra business logic.
  // These are seeded during deployment and are not meant to be updated/deleted by the app, only by admins.
  recurringPlanId                Int? /// Only use `connect`
  recurringPlan                  RecurringPlan?                @relation(fields: [recurringPlanId], references: [id], onDelete: Restrict, onUpdate: Cascade) /// Only use `connect`
  unstable_usagePlanId           Int? /// Unstable, do not use in production. Only use `connect`
  unstable_usagePlan             Unstable_UsagePlan?           @relation(fields: [unstable_usagePlanId], references: [id], onDelete: Restrict, onUpdate: Cascade) /// Unstable, do not use in production. Only use `connect`
  //
  shop                           String
  shopifyStore                   ShopifyStore                  @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)

  @@unique([shop, shopifyId])
}

/// https://shopify.dev/docs/api/admin-graphql/latest/objects/appsubscription#field-status
enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  DECLINED
  EXPIRED
  FROZEN
  PENDING
  ACCEPTED
}

enum CancellationMethod {
  UNINSTALL
  MANUAL
}

/// Mapped to AppRecurringPricing in Shopify's API. These are the pricing details that Shopify will charge the merchant.
model ShopifyRecurringPricing {
  id                         Int                    @id @default(autoincrement())
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @default(now()) @updatedAt
  //
  price                      Float /// The subtotal price of the plan. Mapped to `AppRecurringPricing.price.amount` in Shopify's API
  currencyCode               String
  interval                   ShopifyPricingInterval
  //
  discount                   Float? /// Discount amount for the discount. Mapped to either `AppRecurringPricing.discount.value.amount` if `discountType` is `AMOUNT` or `AppRecurringPricing.discount.value.percentage` if `discountType` is `PERCENTAGE` in Shopify's API
  discountType               ShopifyDiscountType? /// Discount type. Infered via the presence of either `AppRecurringPricing.discount.value.amount` or `AppRecurringPricing.discount.value.percentage`. Shopify won't allow both to be set at the same time.
  discountPriceAfter         Float? /// Price after discount is applied. Mapped to `AppRecurringPricing.discount.priceAfterDiscount.amount` in Shopify's API
  discountCurrencyCode       String? /// Currency code after discount is applied. Mapped to `AppRecurringPricing.discount.priceAfterDiscount.currencyCode` in Shopify's API
  discountDurationIntervals  Int? /// Number of intervals the discount applies to. For example, if the plan is $10/month and the discount is $5/month for 3 months, then this would be 3. Mapped to `AppRecurringPricing.discount.durationLimitInIntervals` in Shopify's API
  discountRemainingIntervals Int? /// Number of intervals remaining for the discount to apply. Mapped to `AppRecurringPricing.discount.remainingDurationInIntervals` in Shopify's API
  //
  /// These are not tied to IDs in Shopify, so we can just reuse the same object for multiple subscriptions
  subscriptions              ShopifySubscription[] /// * Use connectOrCreate

  @@unique([price, currencyCode, interval, discount, discountType, discountPriceAfter, discountCurrencyCode, discountDurationIntervals, discountRemainingIntervals])
}

enum ShopifyDiscountType {
  AMOUNT
  PERCENTAGE
}

/// Mapped to AppUsagePricing in Shopify's API. These are the pricing details that Shopify will charge the merchant.
model Unstable_ShopifyUsagePricing {
  id                  Int                    @id @default(autoincrement())
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @default(now()) @updatedAt
  //
  cappedAmount        Float /// The maximum amount that the merchant will be charged for usage. Mapped to `AppUsagePricing.cappedAmount.amount` in Shopify's API
  currencyCode        String /// The currency code of the capped amount. Mapped to `AppUsagePricing.cappedAmount.currencyCode` in Shopify's API
  interval            ShopifyPricingInterval /// The interval at which the capped amount is calculated. Mapped to `AppUsagePricing.interval` in Shopify's API
  terms               String /// The terms of the usage pricing (The agreement with the merchant). Mapped to `AppUsagePricing.terms` in Shopify's API
  //
  balanceUsed         Float /// The amount of the capped amount that has been used. Mapped to `AppUsagePricing.balanceUsed.amount` in Shopify's API
  balanceCurrencyCode String /// The currency code of the balance used. Mapped to `AppUsagePricing.balanceUsed.currencyCode` in Shopify's API
  //
  /// These are not tied to IDs in Shopify, so we can just reuse the same object for multiple subscriptions
  subscription        ShopifySubscription[] /// * Use connectOrCreate

  @@unique([cappedAmount, currencyCode, interval, terms, balanceUsed, balanceCurrencyCode])
}

// https://shopify.dev/docs/api/admin-graphql/latest/objects/AppRecurringPricing#field-interval
enum ShopifyPricingInterval {
  ANNUAL
  EVERY_30_DAYS
}

// TODO - Rolebased constraint Entries of this table should only be editable by high-level admin in Supabase, not the app itself.
model RecurringPlan {
  id                   Int                    @id @default(autoincrement())
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now()) @updatedAt
  //
  shopifyPlanID        String? /// The ID of the plan in Shopify, used to identify the plan in Shopify's API // * unstable for now
  price                Float /// Price for the interval in USD
  name                 String /// Public name e.g., "Free", "Pro"
  code                 String                 @unique /// Unique identifier of the plan, may be used in the future for API
  level                RecurringPlanLevel     @default(FREE) /// Multiple Plans can have the same level, for example, "Pro" in annual and monthly.
  interval             ShopifyPricingInterval /// Interval at which the price is charged
  trialDays            Int?
  //
  // Limit and Amount columns go together, if you create a limit, you must also create an amount column.
  // It's very important that you append exactly the words `limit` and `amount` to the column name.
  // This is because our Gatekeeper system uses these columns to determine the limits and amounts for the merchant, and it's easier to automate this way.
  // 
  hasQualifiers        Boolean                @default(false)
  hasShippingDiscounts Boolean                @default(false)
  hasBundles           Boolean                @default(false)
  hasRecommendations   Boolean                @default(false)
  hasAssistant         Boolean                @default(false)
  //
  //
  read_generalApis     Boolean /// Whether the merchant can read general APIs
  write_generalApis    Boolean /// Whether the merchant can write general APIs
  //
  subscriptions        ShopifySubscription[] /// * Only use `connect`, do not edit/delete these

  @@unique([name, interval])
  @@unique([name, interval, level])
  @@unique([shopifyPlanID, interval])
  @@unique([shopifyPlanID, interval, level])
}

enum RecurringPlanLevel {
  FREE
  BASIC /// Legacy "Pro" tier — no longer seeded or sold; kept so historical rows load
  ADVANCE
}

// TODO - Rolebased constraint Entries of this table should only be editable by high-level admin in Supabase, not the app itself.
// ! This is an unstable model, it is not meant to be used in production, only for development and testing.
// When the model is stable, the fields will be moved to a `UsagePlan` model and the `Unstable_UsagePlan` model/data will be deleted.
/// Unstable, do not use in production
model Unstable_UsagePlan {
  id            Int                     @id @default(autoincrement())
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @default(now()) @updatedAt
  //
  cappedAmount  Float /// The maximum amount that the merchant will be charged for usage in USD
  name          String /// e.g., "Basic", "Premium"
  code          String                  @unique // unique identifier of the plan, may be used in the future for API
  level         Unstable_UsagePlanLevel @default(PAY_AS_YOU_GO)
  trialDays     Int?
  //
  subscriptions ShopifySubscription[] /// * Only use `connect`, do not edit/delete these
}

/// Unstable, do not use in production
enum Unstable_UsagePlanLevel {
  PAY_AS_YOU_GO
}

model ShopifyShopData {
  id              Int          @id @default(autoincrement())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt
  //
  shopID          BigInt? // TODO set this mandatory or make it as we always have it available after setup
  name            String?
  email           String?
  shopOwnerName   String?
  country         String? // new
  currency        String? // new
  timezone        String?
  primaryLocale   String? // new
  ianaTimezone    String?
  planName        String?
  planDisplayName String?
  myshopifyDomain String?
  hasStorefront   Boolean?
  //
  shop            String       @unique
  shopifyStore    ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)
}

// --------------------------------------------------------
// --------------------------------------------------------
// --------------------------------------------------------

model Campaign {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name   String
  status CampaignStatus @default(DRAFT)

  startAt DateTime?
  endAt   DateTime?

  // ---- Store ownership ----
  shop         String
  shopifyStore ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade)

  holidayId Int?
  holiday   Holiday? @relation(fields: [holidayId], references: [id])

  // Relations
  audiences  Qualifiers[]
  promotions Promotion[]

  @@index([shop])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
}

// Holiday is context, not control logic.
model Holiday {
  id        Int      @id @default(autoincrement())
  name      String
  region    String
  startDate DateTime
  endDate   DateTime

  campaigns Campaign[]
}

model Promotion {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  type   PromotionType
  status PromotionStatus @default(INACTIVE)

  // Campaign ownership
  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Implementation (only one is set)
  shippingDiscountId Int?
  shippingDiscount   ShippingDiscountAction? @relation(fields: [shippingDiscountId], references: [id])

  // Future-proofing
  config Json? // for FREE_GIFT, BUNDLE, etc.
}

enum PromotionType {
  SHIPPING_DISCOUNT
  FREE_GIFT
  BUNDLE
  ORDER_DISCOUNT
}

enum PromotionStatus {
  ACTIVE
  INACTIVE
}

// --------------------------------------------------------
// Product Bundles ("Frequently Bought Together")
// --------------------------------------------------------

/// A percentage-discount bundle over a small set of products (2–4). The
/// storefront theme block shows the bundle on the product page of every
/// product it contains: the app proxy looks up ACTIVE bundles whose items
/// include the page's product (newest-updated wins when several match).
model Bundle {
  id              Int          @id @default(autoincrement())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt
  //
  type            BundleType   @default(CLASSIC)
  title           String /// Storefront heading override + admin display name
  description     String? /// Optional storefront subtitle under the heading
  status          BundleStatus @default(INACTIVE)
  //
  discountPercent Float /// Percent off the summed item prices (0–100)
  //
  items           BundleItem[]
  //
  shop            String
  shopifyStore    ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)

  @@index([shop, status])
}

/// One product line of a bundle (stored as the product's default variant so
/// the storefront can add it to the cart). Title/price/image are snapshots
/// taken from the admin resource picker when the merchant saves — re-saving
/// the bundle refreshes them.
model BundleItem {
  id           Int     @id @default(autoincrement())
  //
  variantId    String /// Shopify GID (`gid://shopify/ProductVariant/456`)
  productId    String? /// Shopify GID of the variant's product — storefront lookup key
  quantity     Int     @default(1)
  position     Int     @default(0)
  //
  productTitle String
  variantTitle String?
  price        Float /// Snapshot unit price, major currency unit
  imageUrl     String?
  //
  bundleId     Int
  bundle       Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([bundleId])
  @@index([productId])
}

enum BundleStatus {
  ACTIVE
  INACTIVE
}

enum BundleType {
  CLASSIC
}


/// A merchant-defined shopping occasion ("Mother's Day", "Sympathy", ...)
/// powering the Smart Recommendations storefront blocks. The date window is
/// recurring yearly (month/day pairs); null months mean "always relevant"
/// (e.g. Birthday).
model Occasion {
  id         Int               @id @default(autoincrement())
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @default(now()) @updatedAt
  //
  name       String
  slug       String /// Storefront identifier + tag suffix (q8:occasion:<slug>)
  icon       String? /// Emoji shown on the storefront tile (suggested from the name)
  status     OccasionStatus    @default(ACTIVE)
  startMonth Int? /// 1-12
  startDay   Int? /// 1-31
  endMonth   Int?
  endDay     Int?
  position   Int               @default(0)
  //
  products   OccasionProduct[]
  collections OccasionCollection[]
  //
  shop         String
  shopifyStore ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)

  @@unique([shop, slug])
  @@index([shop, status])
}

enum OccasionStatus {
  ACTIVE
  INACTIVE
}

/// A curated product for an occasion. Snapshots (title/price/image) are taken
/// from the admin resource picker on save — re-saving refreshes them. Same
/// pattern as BundleItem.
model OccasionProduct {
  id         Int      @id @default(autoincrement())
  //
  productId  String /// Shopify GID (`gid://shopify/Product/123`)
  variantId  String /// Default variant GID so the storefront can add-to-cart
  title      String
  price      Float
  imageUrl   String?
  position   Int      @default(0)
  //
  occasionId Int
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@index([occasionId])
}


/// A collection connected to an occasion: every sellable product in it is a
/// candidate for that occasion (resolved live from Shopify at request time).
model OccasionCollection {
  id           Int      @id @default(autoincrement())
  //
  collectionId String /// Shopify GID (`gid://shopify/Collection/123`)
  title        String
  handle       String?
  imageUrl     String?
  position     Int      @default(0)
  //
  occasionId   Int
  occasion     Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@index([occasionId])
}

/// Smart Recommendations: a merchant rule for the cart page block. Rules are
/// evaluated in `position` order against the cart; the first whose trigger
/// matches decides which products to show and how many.
model RecommendationRule {
  id                     Int                   @id @default(autoincrement())
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @default(now()) @updatedAt
  //
  name                   String
  heading                String? /// Storefront heading override
  status                 RecommendationStatus  @default(ACTIVE)
  position               Int                   @default(0)
  //
  trigger                RecommendationTrigger @default(ALWAYS)
  triggerCollectionId    String? /// CART_HAS_COLLECTION
  triggerCollectionTitle String?
  triggerProductId       String? /// CART_HAS_PRODUCT
  triggerProductTitle    String?
  triggerMinTotal        Float? /// CART_TOTAL_MIN, shop currency
  //
  source                 RecommendationSource  @default(COLLECTION)
  sourceCollectionId     String?
  sourceCollectionTitle  String?
  sourceTag              String?
  /// PRODUCTS source: [{ productId, title, imageUrl }] picked in the admin
  sourceProducts         Json?
  minPrice               Float?
  maxPrice               Float?
  limit                  Int                   @default(4)
  excludeCartItems       Boolean               @default(true)
  //
  shop                   String
  shopifyStore           ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)

  @@index([shop, status, position])
}

enum RecommendationStatus {
  ACTIVE
  INACTIVE
}

enum RecommendationTrigger {
  ALWAYS
  CART_HAS_COLLECTION
  CART_HAS_PRODUCT
  CART_TOTAL_MIN
}

enum RecommendationSource {
  COLLECTION
  TAG
  NEWEST
  PRODUCTS
}

/// A delivery zone for the storefront zip code checker: a list of codes
/// (exact, or prefixes ending in "*"), an optional delivery price, and an
/// optional message. Zones are matched in `position` order.
model DeliveryZone {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  //
  name      String
  zipCodes  String[] /// Normalised: uppercase, no spaces; "331*" is a prefix
  price     Float? /// Delivery price in the shop currency; 0 = free; null = not shown
  message   String? /// Extra line shown with the result
  active    Boolean  @default(true)
  position  Int      @default(0)
  //
  shop         String
  shopifyStore ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)

  @@index([shop, active, position])
}

/// Delivery Rates: the single shipping rate the app's carrier service
/// returns at checkout, priced by the matching DeliveryZone. One per shop.
model CarrierRate {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  //
  enabled       Boolean  @default(true)
  title         String   @default("Local delivery") /// Shown as the shipping method at checkout
  /// Price when no zone matches; null = no rate (checkout blocks the address)
  fallbackPrice Float?
  //
  shop          String       @unique
  shopifyStore  ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)
}

/// Delivery / pickup date rules for the cart calendar: blocked weekdays and
/// dates, lead time and how far ahead shoppers may book. One per shop.
model DeliverySchedule {
  id                     Int      @id @default(autoincrement())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt
  //
  enabled                Boolean  @default(false) /// Show the calendar in the cart
  requireDate            Boolean  @default(true) /// Shoppers must pick a date to continue
  deliveryBlockedWeekdays Int[]   @default([]) /// 0 = Sunday … 6 = Saturday
  deliveryBlockedDates   String[] @default([]) /// ISO yyyy-mm-dd
  deliveryLeadDays       Int      @default(0)
  deliveryMaxDaysAhead   Int      @default(60)
  pickupBlockedWeekdays  Int[]    @default([])
  pickupBlockedDates     String[] @default([])
  pickupLeadDays         Int      @default(0)
  pickupMaxDaysAhead     Int      @default(60)
  /// Same-day rules, evaluated in the shop's time zone (ShopifyShopData.ianaTimezone)
  deliveryTodayEnabled   Boolean  @default(true) /// Offer today at all (subject to lead days)
  deliveryTodayCutoff    String? /// "HH:MM" 24h; today closes at this shop time. Null = all day
  pickupTodayEnabled     Boolean  @default(true)
  pickupTodayCutoff      String?
  //
  shop         String       @unique
  shopifyStore ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)
}

/// What the cart block's Options step shows (Delivery module). The whole
/// step can be switched off; each field can be switched off on its own.
model CartOptionsSettings {
  id                 Int      @id @default(autoincrement())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  //
  enabled            Boolean  @default(true) /// Show the Options step at all
  occasionEnabled    Boolean  @default(true) /// Occasion picker (+ that occasion's products)
  cardMessageEnabled Boolean  @default(true)
  notesEnabled       Boolean  @default(true)
  notesLabel         String   @default("Notes for us") /// Merchant-editable field label
  doorEnabled        Boolean  @default(true) /// "If nobody answers the door" dropdown
  //
  shop         String       @unique
  shopifyStore ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)
}

/// A timed delivery window shoppers can add to a delivery ("Before 12:00 PM")
/// for a surcharge on top of the zone price (Delivery module).
model DeliveryTimeWindow {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  //
  kind      String /// "before" | "after" | "by"
  time      String /// "HH:MM" 24h in the shop's time zone
  price     Float    @default(0) /// Surcharge in the shop currency
  active    Boolean  @default(true)
  position  Int      @default(0)
  //
  shop         String
  shopifyStore ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)

  @@index([shop, active, position])
}

/// The merchant's business profile powering the AI assistant dashboard.
/// Collected in a single confirmation step (niche inferred from products,
/// country prefilled from ShopifyShopData).
model StoreProfile {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  //
  niche         String /// Taxonomy slug (see app/services/assistant/taxonomy.ts)
  nicheLabel    String /// Display label; the merchant's own words for "other"
  country       String?
  note          String? /// Optional "anything else we should know?"
  checklistDone String[] @default([]) /// Brief checklist item ids marked done
  //
  shop          String       @unique
  shopifyStore  ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)
}

/// The latest AI-generated (or curated-fallback) assistant brief for a shop.
/// Regenerated when stale (>7 days), on profile change, or on demand — the
/// dashboard always reads this cache, never Gemini directly.
model DashboardBrief {
  id           Int         @id @default(autoincrement())
  generatedAt  DateTime    @default(now())
  //
  niche        String
  country      String?
  source       BriefSource @default(AI)
  payload      Json /// Validated AssistantBrief (see app/services/assistant/brief.server.ts)
  //
  shop         String       @unique
  shopifyStore ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)
}

enum BriefSource {
  AI
  FALLBACK
}


/// A date that matters for this shop: upserted from AI briefs (source AI)
/// or created by the merchant. Parent of per-date to-dos and executed
/// actions (SEO metadata updates, and future marketing actions).
model SpecialDate {
  id               Int               @id @default(autoincrement())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  //
  name             String
  date             String /// ISO yyyy-mm-dd
  whyItMatters     String?
  source           SpecialDateSource @default(MERCHANT)
  archived         Boolean           @default(false)
  /// Set once the AI to-do starter set has been generated (lazy, on first
  /// open of the manage page) — prevents regenerating after user deletes.
  todosGeneratedAt DateTime?
  //
  todos            SpecialDateTodo[]
  seoActions       SeoMetaAction[]
  announcementBar  AnnouncementBar?
  subscribePopup   SubscribePopup?
  scheduledMenuItem ScheduledMenuItem?
  //
  shop             String
  shopifyStore     ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)

  @@unique([shop, name, date])
  @@index([shop, date])
}

enum SpecialDateSource {
  AI
  MERCHANT
}

model SpecialDateTodo {
  id            Int               @id @default(autoincrement())
  createdAt     DateTime          @default(now())
  //
  title         String
  description   String?
  kind          TodoKind          @default(GENERAL)
  source        SpecialDateSource @default(MERCHANT)
  done          Boolean           @default(false)
  position      Int               @default(0)
  //
  specialDateId Int
  specialDate   SpecialDate @relation(fields: [specialDateId], references: [id], onDelete: Cascade)
  shop          String

  @@index([specialDateId])
  @@index([shop])
}

enum TodoKind {
  SEO
  MARKETING
  GENERAL
}

/// Audit trail of applied SEO metadata updates. Previous values are stored
/// so a future revert is a single mutation.
model SeoMetaAction {
  id                     Int             @id @default(autoincrement())
  createdAt              DateTime        @default(now())
  //
  resourceType           SeoResourceType
  resourceId             String /// Shopify GID
  resourceTitle          String
  previousSeoTitle       String?
  previousSeoDescription String?
  newSeoTitle            String
  newSeoDescription      String
  //
  /// Null when applied from the SEO AI page; set when optimized for a Sales Calendar date.
  specialDateId          Int?
  specialDate            SpecialDate? @relation(fields: [specialDateId], references: [id], onDelete: Cascade)
  shop                   String

  @@index([specialDateId])
  @@index([shop, createdAt])
}

enum SeoResourceType {
  PRODUCT
  COLLECTION
}

/// Per-store AI token accounting — one row per Gemini call. DB-only for
/// now; aggregate when billing or limits need it.
model AiUsage {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  //
  feature      String /// brief | niche-inference | date-todos | seo-meta
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  //
  shop         String
  shopifyStore ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)

  @@index([shop, createdAt])
}


/// A scheduled homepage announcement bar tied to a special date. Served to
/// the storefront via the app proxy only while today falls inside the
/// window; text and colors are merchant-configured in the app.
model AnnouncementBar {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  //
  enabled         Boolean  @default(true)
  message         String
  backgroundColor String   @default("#2c1f58")
  textColor       String   @default("#ffffff")
  startDate       String /// ISO yyyy-mm-dd, inclusive
  endDate         String /// ISO yyyy-mm-dd, inclusive
  //
  /// Null for the shop-wide config edited from its feature page; set when
  /// scheduled from a Sales Calendar date.
  specialDateId   Int?         @unique
  specialDate     SpecialDate? @relation(fields: [specialDateId], references: [id], onDelete: Cascade)
  shop            String

  @@index([shop, startDate, endDate])
}


/// An SEO-friendly FAQ entry attached to a Shopify collection, rendered
/// below the products on the collection page (with FAQPage JSON-LD) by the
/// "Collection FAQs" theme block.
model CollectionFaq {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  //
  collectionId    String /// Shopify GID (`gid://shopify/Collection/123`)
  collectionTitle String /// Snapshot from the resource picker, for admin display
  question        String
  answer          String
  position        Int      @default(0)
  //
  shop            String
  shopifyStore    ShopifyStore @relation(fields: [shop], references: [shop], onDelete: Cascade, onUpdate: Cascade)

  @@index([shop, collectionId])
}


/// A scheduled first-time-subscriber popup tied to a special date. Shown on
/// the home page while inside the window, suppressed for shoppers who are
/// already subscribed (signed-in check) or already saw it (localStorage).
model SubscribePopup {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  //
  enabled       Boolean  @default(true)
  imageUrl      String
  heading       String
  description   String
  discountCode  String
  startDate     String /// ISO yyyy-mm-dd, inclusive
  endDate       String /// ISO yyyy-mm-dd, inclusive
  //
  /// Null for the shop-wide config edited from its feature page; set when
  /// scheduled from a Sales Calendar date.
  specialDateId Int?         @unique
  specialDate   SpecialDate? @relation(fields: [specialDateId], references: [id], onDelete: Cascade)
  shop          String

  @@index([shop, startDate, endDate])
}


/// One row per registered background job: the claim lock and run history
/// for the Cloud Scheduler heartbeat (see app/jobs/).
model JobRun {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  lockedAt      DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  updatedAt     DateTime  @default(now()) @updatedAt
}

/// A navigation menu item scheduled around a special date. The menu-sync
/// job inserts it into the chosen menu when the window opens (recording the
/// created MenuItem id) and removes exactly that item when it closes.
model ScheduledMenuItem {
  id                Int          @id @default(autoincrement())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt
  //
  enabled           Boolean      @default(true)
  menuId            String /// Menu GID
  menuTitle         String /// Snapshot for admin display
  itemTitle         String
  linkType          MenuLinkType @default(COLLECTION)
  resourceId        String? /// Collection GID when linkType is COLLECTION
  resourceTitle     String? /// Snapshot for admin display
  url               String? /// Path/URL when linkType is URL
  startDate         String /// ISO yyyy-mm-dd, inclusive (shop timezone)
  endDate           String /// ISO yyyy-mm-dd, inclusive (shop timezone)
  //
  appliedMenuItemId String? /// Set while our item is live in the menu
  appliedAt         DateTime?
  removedAt         DateTime?
  lastError         String?
  //
  specialDateId     Int         @unique
  specialDate       SpecialDate @relation(fields: [specialDateId], references: [id], onDelete: Cascade)
  shop              String

  @@index([shop, startDate, endDate])
}

enum MenuLinkType {
  COLLECTION
  URL
}
