FROM node:20-alpine

RUN apk add --no-cache openssl

WORKDIR /app

EXPOSE 3000

COPY package.json package-lock.json* ./

# Install production dependencies
RUN npm ci --omit=dev && npm cache clean --force

COPY . .

# Build arguments
ARG DATABASE_URL
ARG SHOPIFY_API_KEY
ARG SHOPIFY_API_SECRET
ARG SHOPIFY_APP_HANDLE
ARG SHOPIFY_BASIC_PLAN_ID
ARG SHOPIFY_FREE_PLAN_ID
ARG SHOPIFY_SHIPPING_DISCOUNTS_ID
ARG SCOPES
ARG SHOPIFY_APP_URL
ARG VITE_SHOPIFY_API_KEY

# Runtime environment
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000

# Vite variable needed during build
ENV VITE_SHOPIFY_API_KEY=${VITE_SHOPIFY_API_KEY}

# Generate Prisma client
RUN npx prisma generate

# Build the app
RUN SKIP_ENV_VALIDATION=true npm run build

# Start the app
CMD ["npm", "run", "docker-start"]