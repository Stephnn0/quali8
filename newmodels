model Campaign {
  id          Int            @id @default(autoincrement())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  name        String
  status      CampaignStatus @default(DRAFT)

  startAt     DateTime?
  endAt       DateTime?

  // Ownership
  shop        String
  shopifyStore ShopifyStore
    @relation(fields: [shop], references: [shop], onDelete: Cascade)

  // Relations
  audiences   Audience[]
  promotions  Promotion[]

  @@index([shop])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
}

---------------------------------------------------------------

model Audience {
  id                   Int        @id @default(autoincrement())
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  name                 String
  description          String
  conditionLogicType   LogicType

  // Ownership
  shop                 String
  shopifyStore         ShopifyStore
    @relation(fields: [shop], references: [shop], onDelete: Cascade)

  // Relations
  conditions            Conditions[]
  customers             Customers[] @relation("CustomerAudiences")
  campaigns             Campaign[]

}


