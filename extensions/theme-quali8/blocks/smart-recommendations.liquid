{%- comment -%}
  Quali8 — Smart Recommendations (product + cart app block).
  Fetches occasion/recipient/budget-aware product picks from the app proxy
  (/apps/quali8/recommendations) and renders a subtle filter row above a
  scroll-snap product carousel. Renders compact on product pages (the block
  sits inside product information). Stays hidden (zero layout shift) until
  recommendations are found.
{%- endcomment -%}

<div
  class="q8-recs"
  data-quali8-recs
  data-context="{{ request.page_type }}"
  {%- if product %} data-product-id="{{ product.id }}"{% endif -%}
  {%- if request.page_type == 'cart' %} data-cart-product-ids="{{ cart.items | map: 'product_id' | join: ',' }}"{% endif -%}
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-heading="{{ block.settings.heading | escape }}"
  data-show-picker="{{ block.settings.show_picker }}"
  data-button-label="{{ block.settings.button_label | escape }}"
  data-added-label="{{ block.settings.added_label | escape }}"
  data-after-add="{{ block.settings.after_add }}"
  style="--q8-recs-bg: {{ block.settings.background_color }}; --q8-recs-text: {{ block.settings.text_color }}; --q8-recs-accent: {{ block.settings.accent_color }};"
  hidden
></div>

{% schema %}
{
  "name": "Smart Recommendations",
  "target": "section",
  "javascript": "smart-recommendations.js",
  "stylesheet": "smart-recommendations.css",
  "enabled_on": {
    "templates": ["product", "cart"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the perfect gift"
    },
    {
      "type": "checkbox",
      "id": "show_picker",
      "label": "Show occasion, recipient, and budget filters",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add button label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "added_label",
      "label": "Added confirmation label",
      "default": "Added ✓"
    },
    {
      "type": "select",
      "id": "after_add",
      "label": "After adding to cart",
      "options": [
        { "value": "stay", "label": "Stay on page" },
        { "value": "cart", "label": "Go to cart" }
      ],
      "default": "stay"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#5c3d99"
    }
  ]
}
{% endschema %}
