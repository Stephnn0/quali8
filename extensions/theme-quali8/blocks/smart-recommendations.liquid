{%- comment -%}
  Quali8 — Smart Recommendations (cart page app block).

  Sends the cart's product ids and subtotal to the app proxy
  (/apps/quali8/smart-recommendations); the merchant's rules decide which
  products come back. Renders a horizontal product rail with one-tap add.
  Stays hidden (zero layout shift) until products are loaded.
{%- endcomment -%}

{%- capture q8_sr_settings -%}
{
  "eyebrow": {{ block.settings.eyebrow | json }},
  "heading": {{ block.settings.heading | json }},
  "subheading": {{ block.settings.subheading | json }},
  "useRuleHeading": {{ block.settings.use_rule_heading | json }},
  "limit": {{ block.settings.products_limit | json }},
  "layout": {{ block.settings.layout | json }},
  "buttonLabel": {{ block.settings.button_label | json }},
  "addingLabel": {{ block.settings.adding_label | json }},
  "addedLabel": {{ block.settings.added_label | json }},
  "afterAdd": {{ block.settings.after_add | json }},
  "showPrice": {{ block.settings.show_price | json }}
}
{%- endcapture -%}

<div
  class="q8-sr q8-sr--{{ block.settings.layout }} q8-sr--btn-{{ block.settings.button_style }} q8-sr--cards-{{ block.settings.card_style }}"
  data-quali8-smart-recs
  data-cart-product-ids="{{ cart.items | map: 'product_id' | join: ',' }}"
  data-cart-total="{{ cart.total_price | divided_by: 100.0 }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  style="
    --q8-sr-bg: {{ block.settings.background_color }};
    --q8-sr-card-bg: {{ block.settings.card_background }};
    --q8-sr-text: {{ block.settings.text_color }};
    --q8-sr-accent: {{ block.settings.accent_color }};
    --q8-sr-btn-bg: {{ block.settings.button_background }};
    --q8-sr-btn-text: {{ block.settings.button_text_color }};
    --q8-sr-heading-size: {{ block.settings.heading_size }}px;
    --q8-sr-radius: {{ block.settings.border_radius }}px;
    --q8-sr-card-radius: {{ block.settings.card_radius }}px;
    --q8-sr-padding: {{ block.settings.padding }}px;
    --q8-sr-border: {% if block.settings.show_border %}1px solid rgba(0, 0, 0, 0.08){% else %}none{% endif %};
    --q8-sr-columns: {{ block.settings.columns_desktop }};
    --q8-sr-columns-mobile: {{ block.settings.columns_mobile }};
    --q8-sr-image-ratio: {% case block.settings.image_ratio %}{% when 'portrait' %}4 / 5{% when 'landscape' %}4 / 3{% else %}1 / 1{% endcase %};
  "
  hidden
>
  <script type="application/json" data-q8-sr-settings>{{ q8_sr_settings | strip }}</script>
</div>

{% schema %}
{
  "name": "Smart Recommendations",
  "target": "section",
  "javascript": "smart-recommendations.js",
  "stylesheet": "smart-recommendations.css",
  "enabled_on": {
    "templates": ["cart"]
  },
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Recommended for you"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete your order"
    },
    {
      "type": "checkbox",
      "id": "use_rule_heading",
      "label": "Let a matching rule override the heading",
      "default": true
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 24
    },

    { "type": "header", "content": "Products" },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Maximum products",
      "info": "Each rule has its own maximum too; the lower one wins.",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "rail", "label": "Scrolling rail" },
        { "value": "grid", "label": "Grid" },
        { "value": "list", "label": "Compact list" }
      ],
      "default": "rail"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "boxed", "label": "Boxed" },
        { "value": "minimal", "label": "Minimal" }
      ],
      "default": "boxed"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },

    { "type": "header", "content": "Add button" },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "Add"
    },
    {
      "type": "text",
      "id": "adding_label",
      "label": "While adding",
      "default": "Adding…"
    },
    {
      "type": "text",
      "id": "added_label",
      "label": "After adding",
      "default": "Added ✓"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "options": [
        { "value": "pill", "label": "Pill on the image" },
        { "value": "full", "label": "Full-width under the card" }
      ],
      "default": "pill"
    },
    {
      "type": "select",
      "id": "after_add",
      "label": "After adding",
      "options": [
        { "value": "reload", "label": "Refresh the cart page" },
        { "value": "stay", "label": "Stay (for drawer carts)" }
      ],
      "default": "reload"
    },

    { "type": "header", "content": "Colors" },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f6fb"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#5c3d99"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },

    { "type": "header", "content": "Spacing & shape" },
    {
      "type": "range",
      "id": "padding",
      "label": "Inner padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Block corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show block border",
      "default": false
    }
  ]
}
{% endschema %}
