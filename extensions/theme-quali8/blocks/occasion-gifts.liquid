{%- comment -%}
  Quali8 — Occasions + Gifts (product page app block).

  A sideways-scrolling row of occasion tiles (icon in a square, name
  below). Tapping a tile opens a popup with gift picks for that occasion,
  fetched from the app proxy (/apps/quali8/recommendations). Occasions,
  their icons, products, and collections are managed in the app. The row
  stays hidden (zero layout shift) until the occasions have loaded.
{%- endcomment -%}

{%- capture q8_settings_json -%}
{
  "heading": {{ block.settings.heading | json }},
  "subheading": {{ block.settings.subheading | json }},
  "showAllTile": {{ block.settings.show_all_tile | json }},
  "allTileLabel": {{ block.settings.all_tile_label | json }},
  "allTileIcon": {{ block.settings.all_tile_icon | json }},
  "showNowBadge": {{ block.settings.show_now_badge | json }},
  "nowLabel": {{ block.settings.now_label | json }},
  "showArrows": {{ block.settings.show_arrows | json }},
  "popupTitle": {{ block.settings.popup_title | json }},
  "popupSubtext": {{ block.settings.popup_subtext | json }},
  "emptyText": {{ block.settings.empty_text | json }},
  "limit": {{ block.settings.products_limit | json }},
  "showReason": {{ block.settings.show_reason | json }},
  "closeOnOverlay": {{ block.settings.close_on_overlay | json }},
  "buttonLabel": {{ block.settings.button_label | json }},
  "addingLabel": {{ block.settings.adding_label | json }},
  "addedLabel": {{ block.settings.added_label | json }},
  "afterAdd": {{ block.settings.after_add | json }}
}
{%- endcapture -%}

<div
  class="q8-og q8-og--tiles-{{ block.settings.tile_size }} q8-og--shape-{{ block.settings.tile_shape }} q8-og--style-{{ block.settings.tile_style }} q8-og--align-{{ block.settings.text_align }} q8-og--btn-{{ block.settings.button_size }} q8-og--btn-{{ block.settings.button_style }} q8-og--popup-{{ block.settings.popup_size }}{% if block.settings.overlay_blur %} q8-og--blur{% endif %}"
  data-quali8-occasions
  {%- if product %} data-product-id="{{ product.id }}"{% endif -%}
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  style="
    --q8-og-bg: {{ block.settings.background_color }};
    --q8-og-text: {{ block.settings.text_color }};
    --q8-og-accent: {{ block.settings.accent_color }};
    --q8-og-tile-bg: {{ block.settings.tile_background }};
    --q8-og-popup-bg: {{ block.settings.popup_background }};
    --q8-og-btn-bg: {{ block.settings.button_background }};
    --q8-og-btn-text: {{ block.settings.button_text_color }};
    --q8-og-overlay: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    --q8-og-heading-size: {{ block.settings.heading_size }}px;
    --q8-og-heading-size-mobile: {{ block.settings.heading_size | times: 0.8 | round }}px;
    --q8-og-radius: {{ block.settings.border_radius }}px;
    --q8-og-tile-radius: {{ block.settings.tile_radius }}px;
    --q8-og-popup-radius: {{ block.settings.popup_radius }}px;
    --q8-og-padding: {{ block.settings.padding }}px;
    --q8-og-border: {% if block.settings.show_border %}1px solid rgba(0, 0, 0, 0.08){% else %}none{% endif %};
    --q8-og-columns: {{ block.settings.popup_columns }};
    --q8-og-columns-mobile: {{ block.settings.columns_mobile }};
    --q8-og-image-ratio: {% case block.settings.image_ratio %}{% when 'portrait' %}4 / 5{% when 'landscape' %}4 / 3{% else %}1 / 1{% endcase %};
  "
  hidden
>
  <script type="application/json" data-q8-settings>{{ q8_settings_json | strip }}</script>
</div>

{% schema %}
{
  "name": "Occasions + Gifts",
  "target": "section",
  "javascript": "occasion-gifts.js",
  "stylesheet": "occasion-gifts.css",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shopping for an occasion?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Tap one to see our gift picks."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },

    { "type": "header", "content": "Occasion tiles" },
    {
      "type": "select",
      "id": "tile_size",
      "label": "Tile size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "tile_shape",
      "label": "Tile shape",
      "options": [
        { "value": "rounded", "label": "Rounded square" },
        { "value": "square", "label": "Square" },
        { "value": "circle", "label": "Circle" }
      ],
      "default": "rounded"
    },
    {
      "type": "select",
      "id": "tile_style",
      "label": "Tile style",
      "options": [
        { "value": "soft", "label": "Soft fill" },
        { "value": "outline", "label": "Outline" },
        { "value": "solid", "label": "Solid accent" }
      ],
      "default": "soft"
    },
    {
      "type": "checkbox",
      "id": "show_all_tile",
      "label": "Add an \"all gifts\" tile",
      "info": "Opens picks without an occasion. Also shows when no occasion is active.",
      "default": true
    },
    {
      "type": "text",
      "id": "all_tile_label",
      "label": "\"All gifts\" tile label",
      "default": "All gifts"
    },
    {
      "type": "text",
      "id": "all_tile_icon",
      "label": "\"All gifts\" tile icon",
      "default": "🎁"
    },
    {
      "type": "checkbox",
      "id": "show_now_badge",
      "label": "Mark in-season occasions",
      "default": true
    },
    {
      "type": "text",
      "id": "now_label",
      "label": "In-season badge",
      "default": "Now"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show scroll arrows",
      "default": true
    },

    { "type": "header", "content": "Popup" },
    {
      "type": "text",
      "id": "popup_title",
      "label": "Popup title",
      "info": "Use {occasion} for the occasion name.",
      "default": "Gifts for {occasion}"
    },
    {
      "type": "text",
      "id": "popup_subtext",
      "label": "Popup subtext",
      "default": "Hand-picked for the moment."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Text when nothing matches",
      "default": "No gift picks for this occasion yet."
    },
    {
      "type": "select",
      "id": "popup_size",
      "label": "Popup width",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Number of products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "popup_columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_reason",
      "label": "Show \"why this pick\" tags",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Background dim",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "checkbox",
      "id": "overlay_blur",
      "label": "Blur the page behind",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "close_on_overlay",
      "label": "Close when clicking outside",
      "default": true
    },

    { "type": "header", "content": "Add to cart button" },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "adding_label",
      "label": "While adding",
      "default": "Adding…"
    },
    {
      "type": "text",
      "id": "added_label",
      "label": "After adding",
      "default": "Added ✓"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "solid"
    },
    {
      "type": "select",
      "id": "after_add",
      "label": "After adding to cart",
      "options": [
        { "value": "stay", "label": "Stay in the popup" },
        { "value": "cart", "label": "Go to cart" }
      ],
      "default": "stay"
    },

    { "type": "header", "content": "Colors" },
    {
      "type": "color",
      "id": "background_color",
      "label": "Block background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tile_background",
      "label": "Tile background",
      "default": "#f3effc"
    },
    {
      "type": "color",
      "id": "popup_background",
      "label": "Popup background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "info": "Selected tile, badges, tags, and focus rings.",
      "default": "#5c3d99"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button",
      "default": "#5c3d99"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },

    { "type": "header", "content": "Spacing & shape" },
    {
      "type": "range",
      "id": "padding",
      "label": "Inner padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Block corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "tile_radius",
      "label": "Tile corner radius",
      "info": "Rounded square shape only.",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "popup_radius",
      "label": "Popup corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show block border",
      "default": false
    }
  ]
}
{% endschema %}
