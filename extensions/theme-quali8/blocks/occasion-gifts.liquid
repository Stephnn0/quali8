{%- comment -%}
  Quali8 — Occasions + Gifts (product page app block).

  Asks "Shopping for an occasion?", suggests a few occasion chips (in-season
  first) with an "Other occasions" picker for the rest, then swaps in a
  sideways rail of that occasion's gifts. One button adds the product being
  viewed together with the gift. Occasions, their icons, their products, and
  everything the block says and does are managed in the app (Occasions page)
  and fetched from the app proxy; the theme editor keeps colours, sizes, and
  corners. The block stays hidden (zero layout shift) until it has loaded.
{%- endcomment -%}

{%- assign q8_variant = product.selected_or_first_available_variant -%}

<div
  class="q8-og q8-og--chips-{{ block.settings.chip_style }} q8-og--btn-{{ block.settings.button_style }}{% if block.settings.overlay_blur %} q8-og--blur{% endif %}"
  data-quali8-occasions
  {%- if product %} data-product-id="{{ product.id }}" data-product-title="{{ product.title | escape }}"{% endif -%}
  {%- if q8_variant %} data-variant-id="{{ q8_variant.id }}" data-product-price="{{ q8_variant.price }}"{% endif -%}
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-close-on-overlay="{{ block.settings.close_on_overlay }}"
  style="
    --q8-og-bg: {{ block.settings.background_color }};
    --q8-og-text: {{ block.settings.text_color }};
    --q8-og-accent: {{ block.settings.accent_color }};
    --q8-og-tile-bg: {{ block.settings.tile_background }};
    --q8-og-popup-bg: {{ block.settings.popup_background }};
    --q8-og-btn-bg: {{ block.settings.button_background }};
    --q8-og-btn-text: {{ block.settings.button_text_color }};
    --q8-og-overlay: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    --q8-og-heading-size: {{ block.settings.heading_size }}px;
    --q8-og-radius: {{ block.settings.border_radius }}px;
    --q8-og-tile-radius: {{ block.settings.tile_radius }}px;
    --q8-og-popup-radius: {{ block.settings.popup_radius }}px;
    --q8-og-padding: {{ block.settings.padding }}px;
    --q8-og-border: {% if block.settings.show_border %}1px solid rgba(0, 0, 0, 0.08){% else %}none{% endif %};
    --q8-og-card-width: {{ block.settings.card_width }}px;
  "
  hidden
></div>

{% schema %}
{
  "name": "Occasions + Gifts",
  "target": "section",
  "javascript": "occasion-gifts.js",
  "stylesheet": "occasion-gifts.css",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "What the block says and does — the question, the suggested occasions, the gifts, and the add-to-cart button — is set in the app under Occasions. This panel is looks only."
    },

    { "type": "header", "content": "Text" },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 22
    },

    { "type": "header", "content": "Occasion chips" },
    {
      "type": "select",
      "id": "chip_style",
      "label": "Chip style",
      "options": [
        { "value": "soft", "label": "Soft fill" },
        { "value": "outline", "label": "Outline" },
        { "value": "solid", "label": "Solid accent" }
      ],
      "default": "soft"
    },
    {
      "type": "range",
      "id": "tile_radius",
      "label": "Chip corner radius",
      "info": "40 makes a pill.",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 40
    },

    { "type": "header", "content": "Gift cards" },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "min": 140,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "solid"
    },

    { "type": "header", "content": "Occasion picker popup" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Background dim",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "checkbox",
      "id": "overlay_blur",
      "label": "Blur the page behind",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "close_on_overlay",
      "label": "Close when clicking outside",
      "default": true
    },
    {
      "type": "range",
      "id": "popup_radius",
      "label": "Popup corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },

    { "type": "header", "content": "Colors" },
    {
      "type": "color",
      "id": "background_color",
      "label": "Block background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tile_background",
      "label": "Chip background",
      "default": "#f3effc"
    },
    {
      "type": "color",
      "id": "popup_background",
      "label": "Popup background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "info": "Selected chip, badges, and focus rings.",
      "default": "#5c3d99"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button",
      "default": "#5c3d99"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },

    { "type": "header", "content": "Spacing & shape" },
    {
      "type": "range",
      "id": "padding",
      "label": "Inner padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Block corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show block border",
      "default": false
    }
  ]
}
{% endschema %}
