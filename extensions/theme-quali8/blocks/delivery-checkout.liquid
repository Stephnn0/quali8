{%- comment -%}
  Quali8 — Delivery checkout (cart page app block).

  A delivery gate before checkout. The shopper enters a zip code; the app
  checks it against the merchant's delivery zones (/apps/quali8/delivery-check).
  When delivery is available they fill in the shipping address, which is
  saved to cart attributes as they type, and a Checkout button opens
  Shopify's checkout with the address prefilled. While the zip is not
  deliverable, the theme's own checkout and express-payment buttons are
  hidden so the gate cannot be skipped. Renders nothing when the zip checker
  is off in the app.
{%- endcomment -%}

{%- capture q8_dc_settings -%}
{
  "heading": {{ block.settings.heading | json }},
  "subheading": {{ block.settings.subheading | json }},
  "zipPrompt": {{ block.settings.zip_prompt | json }},
  "zipPlaceholder": {{ block.settings.zip_placeholder | json }},
  "checkLabel": {{ block.settings.check_label | json }},
  "checkingLabel": {{ block.settings.checking_label | json }},
  "successText": {{ block.settings.success_text | json }},
  "priceText": {{ block.settings.price_text | json }},
  "freeText": {{ block.settings.free_text | json }},
  "failText": {{ block.settings.fail_text | json }},
  "changeLabel": {{ block.settings.change_label | json }},
  "rememberZip": {{ block.settings.remember_zip | json }},
  "addressHeading": {{ block.settings.address_heading | json }},
  "showAddress2": {{ block.settings.show_address2 | json }},
  "showPhone": {{ block.settings.show_phone | json }},
  "requirePhone": {{ block.settings.require_phone | json }},
  "showEmail": {{ block.settings.show_email | json }},
  "labels": {
    "firstName": {{ block.settings.first_name_label | json }},
    "lastName": {{ block.settings.last_name_label | json }},
    "address1": {{ block.settings.address1_label | json }},
    "address2": {{ block.settings.address2_label | json }},
    "city": {{ block.settings.city_label | json }},
    "province": {{ block.settings.province_label | json }},
    "country": {{ block.settings.country_label | json }},
    "phone": {{ block.settings.phone_label | json }},
    "email": {{ block.settings.email_label | json }}
  },
  "checkoutLabel": {{ block.settings.checkout_label | json }},
  "checkoutHint": {{ block.settings.checkout_hint | json }},
  "hideThemeCheckout": {{ block.settings.hide_theme_checkout | json }},
  "checkoutSelector": {{ block.settings.checkout_selector | json }},
  "savedLabel": {{ block.settings.saved_label | json }}
}
{%- endcapture -%}

<div
  class="q8-dc q8-dc--{{ block.settings.field_size }}"
  data-quali8-delivery-checkout
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-country="{{ localization.country.iso_code | default: shop.address.country_code }}"
  data-cart-count="{{ cart.item_count }}"
  {%- if customer %} data-customer-email="{{ customer.email | escape }}"{% endif -%}
  style="
    --q8-dc-bg: {{ block.settings.background_color }};
    --q8-dc-text: {{ block.settings.text_color }};
    --q8-dc-accent: {{ block.settings.accent_color }};
    --q8-dc-input-bg: {{ block.settings.input_background }};
    --q8-dc-btn-bg: {{ block.settings.button_background }};
    --q8-dc-btn-text: {{ block.settings.button_text_color }};
    --q8-dc-heading-size: {{ block.settings.heading_size }}px;
    --q8-dc-radius: {{ block.settings.border_radius }}px;
    --q8-dc-input-radius: {{ block.settings.input_radius }}px;
    --q8-dc-padding: {{ block.settings.padding }}px;
    --q8-dc-border: {% if block.settings.show_border %}1px solid rgba(0, 0, 0, 0.08){% else %}none{% endif %};
  "
  hidden
>
  <script type="application/json" data-q8-dc-settings>{{ q8_dc_settings | strip }}</script>
  <script type="application/json" data-q8-dc-attributes>{{ cart.attributes | json }}</script>
</div>

{% schema %}
{
  "name": "Delivery checkout",
  "target": "section",
  "javascript": "delivery-checkout.js",
  "stylesheet": "delivery-checkout.css",
  "enabled_on": {
    "templates": ["cart"]
  },
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Delivery details"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Check your area, add your address, and go straight to checkout."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "text",
      "id": "saved_label",
      "label": "Saved indicator",
      "default": "Saved"
    },

    { "type": "header", "content": "Zip check" },
    {
      "type": "text",
      "id": "zip_prompt",
      "label": "Prompt",
      "default": "Where are we delivering?"
    },
    {
      "type": "text",
      "id": "zip_placeholder",
      "label": "Input placeholder",
      "default": "ZIP code"
    },
    {
      "type": "text",
      "id": "check_label",
      "label": "Button",
      "default": "Check availability"
    },
    {
      "type": "text",
      "id": "checking_label",
      "label": "Button while checking",
      "default": "Checking…"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "We deliver",
      "info": "Use {zip} for the code.",
      "default": "Great, we deliver to {zip}."
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "Price line",
      "info": "Use {price}.",
      "default": "Delivery {price}"
    },
    {
      "type": "text",
      "id": "free_text",
      "label": "Free delivery line",
      "default": "Free delivery"
    },
    {
      "type": "text",
      "id": "fail_text",
      "label": "We don't deliver",
      "default": "Sorry, we don't deliver to {zip} yet. Try another code."
    },
    {
      "type": "text",
      "id": "change_label",
      "label": "Change link",
      "default": "Change"
    },
    {
      "type": "checkbox",
      "id": "remember_zip",
      "label": "Remember the shopper's code",
      "default": true
    },

    { "type": "header", "content": "Address form" },
    {
      "type": "text",
      "id": "address_heading",
      "label": "Form heading",
      "default": "Shipping address"
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "label": "Ask for email",
      "info": "Prefilled at checkout. Hidden for signed-in customers.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_address2",
      "label": "Show apartment / suite line",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "require_phone",
      "label": "Require phone",
      "default": false
    },
    {
      "type": "text",
      "id": "first_name_label",
      "label": "First name label",
      "default": "First name"
    },
    {
      "type": "text",
      "id": "last_name_label",
      "label": "Last name label",
      "default": "Last name"
    },
    {
      "type": "text",
      "id": "address1_label",
      "label": "Address label",
      "default": "Address"
    },
    {
      "type": "text",
      "id": "address2_label",
      "label": "Apartment label",
      "default": "Apartment, suite, etc."
    },
    {
      "type": "text",
      "id": "city_label",
      "label": "City label",
      "default": "City"
    },
    {
      "type": "text",
      "id": "province_label",
      "label": "State / province label",
      "default": "State"
    },
    {
      "type": "text",
      "id": "country_label",
      "label": "Country label",
      "default": "Country"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "Phone"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },

    { "type": "header", "content": "Checkout" },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout button",
      "default": "Continue to checkout"
    },
    {
      "type": "text",
      "id": "checkout_hint",
      "label": "Hint under the button",
      "default": "Your address will already be filled in."
    },
    {
      "type": "checkbox",
      "id": "hide_theme_checkout",
      "label": "Hide the theme's checkout buttons until delivery is confirmed",
      "info": "Also hides express buttons (Shop Pay, Apple Pay, Google Pay), which cannot be prefilled.",
      "default": true
    },
    {
      "type": "text",
      "id": "checkout_selector",
      "label": "Checkout button selector",
      "info": "CSS selector for the theme's checkout buttons. Change only if the default misses your theme.",
      "default": "form[action*=\"/cart\"] [name=\"checkout\"], .shopify-payment-button, .additional-checkout-buttons, [data-shopify=\"dynamic-checkout-cart\"], .cart__dynamic-checkout-buttons"
    },

    { "type": "header", "content": "Colors" },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Field background",
      "default": "#f7f7f9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#5c3d99"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Checkout button",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Checkout button text",
      "default": "#ffffff"
    },

    { "type": "header", "content": "Spacing & shape" },
    {
      "type": "select",
      "id": "field_size",
      "label": "Field size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Inner padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Block corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "input_radius",
      "label": "Field corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show block border",
      "default": true
    }
  ]
}
{% endschema %}
