  "savedLabel": {{ block.settings.saved_label | json }},
  "steps": {
    "sender": {{ block.settings.step_sender_label | json }},
    "method": {{ block.settings.step_method_label | json }},
    "summary": {{ block.settings.step_summary_label | json }}
  },
  "continueLabel": {{ block.settings.continue_label | json }},
  "backLabel": {{ block.settings.back_label | json }},
  "sender": {
    "title": {{ block.settings.sender_title | json }},
    "intro": {{ block.settings.sender_intro | json }},
    "senderHeading": {{ block.settings.sender_heading | json }},
    "recipientHeading": {{ block.settings.recipient_heading | json }},
    "selfLabel": {{ block.settings.self_label | json }},
    "requirePhone": {{ block.settings.require_phone | json }},
    "labels": {
      "email": {{ block.settings.email_label | json }},
      "firstName": {{ block.settings.first_name_label | json }},
      "lastName": {{ block.settings.last_name_label | json }},
      "phone": {{ block.settings.phone_label | json }}
    }
  },
  "method": {
    "title": {{ block.settings.method_title | json }},
    "intro": {{ block.settings.method_intro | json }},
    "deliveryLabel": {{ block.settings.delivery_label | json }},
    "deliveryHint": {{ block.settings.delivery_hint | json }},
    "pickupEnabled": {{ block.settings.pickup_enabled | json }},
    "pickupLabel": {{ block.settings.pickup_label | json }},
    "pickupHint": {{ block.settings.pickup_hint | json }},
    "pickupNote": {{ block.settings.pickup_note | json }},
    "deliveringTo": {{ block.settings.delivering_to_label | json }},
    "zipPrompt": {{ block.settings.zip_prompt | json }},
    "zipPlaceholder": {{ block.settings.zip_placeholder | json }},
    "checkLabel": {{ block.settings.check_label | json }},
    "successText": {{ block.settings.success_text | json }},
    "priceText": {{ block.settings.price_text | json }},
    "freeText": {{ block.settings.free_text | json }},
    "failText": {{ block.settings.fail_text | json }},
    "changeLabel": {{ block.settings.change_label | json }},
    "rememberZip": {{ block.settings.remember_zip | json }},
    "addressHeading": {{ block.settings.address_heading | json }},
    "locationTypeLabel": {{ block.settings.location_type_label | json }},
    "locationTypes": {{ block.settings.location_types | json }},
    "showAddress2": {{ block.settings.show_address2 | json }},
    "labels": {
      "address1": {{ block.settings.address1_label | json }},
      "address2": {{ block.settings.address2_label | json }},
      "city": {{ block.settings.city_label | json }},
      "province": {{ block.settings.province_label | json }},
      "country": {{ block.settings.country_label | json }}
    }
  },
  "summary": {
    "title": {{ block.settings.summary_title | json }},
    "intro": {{ block.settings.summary_intro | json }},
    "senderRow": {{ block.settings.summary_sender_label | json }},
    "recipientRow": {{ block.settings.summary_recipient_label | json }},
    "methodRow": {{ block.settings.summary_method_label | json }},
    "checkoutLabel": {{ block.settings.checkout_label | json }},
    "checkoutHint": {{ block.settings.checkout_hint | json }}
  },
  "order": {
    "title": {{ block.settings.order_title | json }},
    "subtotalLabel": {{ block.settings.order_subtotal_label | json }},
    "deliveryLabel": {{ block.settings.order_delivery_label | json }},
    "deliveryPending": {{ block.settings.order_delivery_pending | json }},
    "totalLabel": {{ block.settings.order_total_label | json }},
    "showDiscount": {{ block.settings.show_discount | json }},
    "discountPlaceholder": {{ block.settings.discount_placeholder | json }}
  },
  "hideThemeCheckout": {{ block.settings.hide_theme_checkout | json }},
  "checkoutSelector": {{ block.settings.checkout_selector | json }}
}
{%- endcapture -%}

{%- capture q8_dc_cart -%}
{
  "count": {{ cart.item_count }},
  "subtotal": {{ cart.items_subtotal_price | divided_by: 100.0 }},
  "items": [
    {%- for item in cart.items -%}
    {
      "title": {{ item.product.title | json }},
      "variant": {{ item.variant.title | json }},
      "quantity": {{ item.quantity }},
      "price": {{ item.final_line_price | divided_by: 100.0 }},
      "image": {% if item.image %}{{ item.image | image_url: width: 160 | json }}{% else %}null{% endif %}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
{%- endcapture -%}

<div
  class="q8-dc q8-dc--{{ block.settings.field_size }}{% if block.settings.serif_headings %} q8-dc--serif{% endif %}"
  data-quali8-delivery-checkout
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-country="{{ localization.country.iso_code | default: shop.address.country_code }}"
  {%- if customer %} data-customer-email="{{ customer.email | escape }}" data-customer-first="{{ customer.first_name | escape }}" data-customer-last="{{ customer.last_name | escape }}"{% endif -%}
  style="
    --q8-dc-page: {{ block.settings.page_background }};
    --q8-dc-bg: {{ block.settings.card_background }};
    --q8-dc-text: {{ block.settings.text_color }};
    --q8-dc-accent: {{ block.settings.accent_color }};
    --q8-dc-input-bg: {{ block.settings.input_background }};
    --q8-dc-btn-bg: {{ block.settings.button_background }};
    --q8-dc-btn-text: {{ block.settings.button_text_color }};
    --q8-dc-heading-size: {{ block.settings.heading_size }}px;
    --q8-dc-radius: {{ block.settings.border_radius }}px;
    --q8-dc-input-radius: {{ block.settings.input_radius }}px;
    --q8-dc-padding: {{ block.settings.padding }}px;
  "
  hidden
>
  <script type="application/json" data-q8-dc-settings>{{ q8_dc_settings | strip }}</script>
  <script type="application/json" data-q8-dc-attributes>{{ cart.attributes | json }}</script>
  <script type="application/json" data-q8-dc-cart>{{ q8_dc_cart | strip }}</script>
</div>

{% schema %}
{
  "name": "Delivery checkout",
  "target": "section",
  "javascript": "delivery-checkout.js",
  "stylesheet": "delivery-checkout.css",
  "enabled_on": {
    "templates": ["cart"]
  },
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Page heading", "default": "Checkout" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 44 },
    { "type": "checkbox", "id": "serif_headings", "label": "Serif headings", "default": true },
    { "type": "text", "id": "step_sender_label", "label": "Step 1 label", "default": "Who's sending?" },
    { "type": "text", "id": "step_method_label", "label": "Step 2 label", "default": "Delivery / Pickup" },
    { "type": "text", "id": "step_summary_label", "label": "Step 3 label", "default": "Review & Checkout" },
    { "type": "text", "id": "continue_label", "label": "Continue button", "default": "Continue" },
    { "type": "text", "id": "back_label", "label": "Back link", "default": "Back" },
    { "type": "text", "id": "saved_label", "label": "Saved indicator", "default": "Saved" },

    { "type": "header", "content": "Step 1: Who's sending?" },
    { "type": "text", "id": "sender_title", "label": "Title", "default": "Who's sending?" },
    { "type": "text", "id": "sender_intro", "label": "Intro", "default": "Tell us who this is from and who it's for." },
    { "type": "text", "id": "sender_heading", "label": "Sender heading", "default": "Your details" },
    { "type": "text", "id": "recipient_heading", "label": "Recipient heading", "default": "Recipient" },
    { "type": "text", "id": "self_label", "label": "Sending to myself switch", "default": "I'm sending this to myself" },
    { "type": "checkbox", "id": "require_phone", "label": "Require phone numbers", "default": true },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "first_name_label", "label": "First name label", "default": "First name" },
    { "type": "text", "id": "last_name_label", "label": "Last name label", "default": "Last name" },
    { "type": "text", "id": "phone_label", "label": "Phone label", "default": "Phone" },

    { "type": "header", "content": "Step 2: Delivery / Pickup" },
    { "type": "text", "id": "method_title", "label": "Title", "default": "Delivery" },
    { "type": "text", "id": "method_intro", "label": "Intro", "default": "Where and when should we deliver these flowers?" },
    { "type": "text", "id": "delivery_label", "label": "Delivery option", "default": "Delivery" },
    { "type": "text", "id": "delivery_hint", "label": "Delivery option hint", "default": "Sent to an address" },
    { "type": "checkbox", "id": "pickup_enabled", "label": "Offer pickup", "default": true },
    { "type": "text", "id": "pickup_label", "label": "Pickup option", "default": "Pickup" },
    { "type": "text", "id": "pickup_hint", "label": "Pickup option hint", "default": "Collect in store" },
    { "type": "textarea", "id": "pickup_note", "label": "Pickup details", "info": "Shown when pickup is chosen, e.g. your address and hours.", "default": "Pick up at our shop during opening hours. We'll email you when it's ready." },
    { "type": "text", "id": "delivering_to_label", "label": "Delivering-to line", "info": "Use {name} and {phone}.", "default": "Delivering to: {name} · {phone}" },
    { "type": "text", "id": "zip_prompt", "label": "Zip prompt", "default": "Check we deliver to the address" },
    { "type": "text", "id": "zip_placeholder", "label": "Zip placeholder", "default": "ZIP code" },
    { "type": "text", "id": "check_label", "label": "Check button", "default": "Check" },
    { "type": "text", "id": "success_text", "label": "We deliver", "info": "Use {zip}.", "default": "Great, we deliver to {zip}." },
    { "type": "text", "id": "price_text", "label": "Price line", "info": "Use {price}.", "default": "Delivery {price}" },
    { "type": "text", "id": "free_text", "label": "Free delivery line", "default": "Free delivery" },
    { "type": "text", "id": "fail_text", "label": "We don't deliver", "default": "Sorry, we don't deliver to {zip} yet. Try another code or choose pickup." },
    { "type": "text", "id": "change_label", "label": "Change zip link", "default": "Change" },
    { "type": "checkbox", "id": "remember_zip", "label": "Remember the shopper's zip", "default": true },
    { "type": "text", "id": "address_heading", "label": "Address heading", "default": "Delivery Address" },
    { "type": "text", "id": "location_type_label", "label": "Location type label", "info": "Leave empty to hide the chips.", "default": "Location Type" },
    { "type": "text", "id": "location_types", "label": "Location types", "info": "Comma-separated.", "default": "Residence, Apartment, Business, Hospital, Funeral Home, Church, School, Nursing Home, Other" },
    { "type": "checkbox", "id": "show_address2", "label": "Show apartment / suite line", "default": true },
    { "type": "text", "id": "address1_label", "label": "Street address label", "default": "Street Address" },
    { "type": "text", "id": "address2_label", "label": "Apartment label", "default": "Apt / Suite / Unit" },
    { "type": "text", "id": "city_label", "label": "City label", "default": "City" },
    { "type": "text", "id": "province_label", "label": "State / province label", "default": "State" },
    { "type": "text", "id": "country_label", "label": "Country label", "default": "Country" },

    { "type": "header", "content": "Step 3 & order summary" },
    { "type": "text", "id": "summary_title", "label": "Title", "default": "Review & Checkout" },
    { "type": "text", "id": "summary_intro", "label": "Intro", "default": "Everything look right?" },
    { "type": "text", "id": "summary_sender_label", "label": "Sender row", "default": "From" },
    { "type": "text", "id": "summary_recipient_label", "label": "Recipient row", "default": "To" },
    { "type": "text", "id": "summary_method_label", "label": "Method row", "default": "Delivery" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button", "default": "Continue to checkout" },
    { "type": "text", "id": "checkout_hint", "label": "Hint under the button", "default": "The shipping address will already be filled in." },
    { "type": "text", "id": "order_title", "label": "Order card title", "default": "Order summary" },
    { "type": "text", "id": "order_subtotal_label", "label": "Subtotal label", "default": "Subtotal" },
    { "type": "text", "id": "order_delivery_label", "label": "Delivery label", "default": "Delivery" },
    { "type": "text", "id": "order_delivery_pending", "label": "Delivery before it's known", "default": "Calculated at checkout" },
    { "type": "text", "id": "order_total_label", "label": "Total label", "default": "Total" },
    { "type": "checkbox", "id": "show_discount", "label": "Show a discount code field", "info": "Applied when checkout opens.", "default": true },
    { "type": "text", "id": "discount_placeholder", "label": "Discount field placeholder", "default": "Have a partner code?" },
    { "type": "checkbox", "id": "hide_theme_checkout", "label": "Hide the theme's checkout buttons until the summary is complete", "default": true },
    { "type": "text", "id": "checkout_selector", "label": "Checkout button selector", "info": "CSS selector for the theme's checkout and express buttons.", "default": "form[action*=\"/cart\"] [name=\"checkout\"], .shopify-payment-button, .additional-checkout-buttons, [data-shopify=\"dynamic-checkout-cart\"], .cart__dynamic-checkout-buttons" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "page_background", "label": "Block background", "default": "#fbf8f3" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "input_background", "label": "Field background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#14201d" },
    { "type": "color", "id": "accent_color", "label": "Accent", "info": "Steps, selected chips, totals.", "default": "#0f3d3e" },
    { "type": "color", "id": "button_background", "label": "Buttons", "default": "#0f3d3e" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },

    { "type": "header", "content": "Spacing & shape" },
    { "type": "select", "id": "field_size", "label": "Field size", "options": [ { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ], "default": "medium" },
    { "type": "range", "id": "padding", "label": "Inner padding", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "border_radius", "label": "Card corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "input_radius", "label": "Field corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 10 }
  ]
}
{% endschema %}
